{
  "$description": "Althorn design tokens — W3C/Tokens Studio format. Import via the Tokens Studio for Figma plugin (Import > File), or Figma Variables via any DTCG-compatible plugin.",
  "palette": {
    "cream":       { "$type": "color", "$value": "#FAF7F2" },
    "sand":        { "$type": "color", "$value": "#E8E2D9" },
    "mist":        { "$type": "color", "$value": "#E8F0F0" },
    "white":       { "$type": "color", "$value": "#FFFFFF" },
    "charcoal":    { "$type": "color", "$value": "#2D2D2D" },
    "charcoal-700":{ "$type": "color", "$value": "#605C57" },
    "charcoal-500":{ "$type": "color", "$value": "#8A857E" },
    "teal":        { "$type": "color", "$value": "#2A6F6F" },
    "teal-light":  { "$type": "color", "$value": "#357F7F" },
    "teal-300":    { "$type": "color", "$value": "#4E9E9E" },
    "teal-200":    { "$type": "color", "$value": "#62B3B3" },
    "terra":       { "$type": "color", "$value": "#C4704B" },
    "terra-light": { "$type": "color", "$value": "#D4805B" },
    "terra-300":   { "$type": "color", "$value": "#DB8A64" },
    "sage":        { "$type": "color", "$value": "#8B9E7E" },
    "ink-900":     { "$type": "color", "$value": "#1A1917" },
    "ink-800":     { "$type": "color", "$value": "#232220" },
    "ink-700":     { "$type": "color", "$value": "#2A2724" },
    "ink-tint":    { "$type": "color", "$value": "#1E2A2A" },
    "ink-border":  { "$type": "color", "$value": "#38352F" },
    "paper-100":   { "$type": "color", "$value": "#F2EEE8" },
    "paper-300":   { "$type": "color", "$value": "#B3ADA5" },
    "paper-500":   { "$type": "color", "$value": "#857F77" },
    "border":      { "$type": "color", "$value": "#E1DAD0" },
    "border-strong":{ "$type": "color", "$value": "#CFC6B9" }
  },
  "theme": {
    "light": {
      "canvas":        { "$type": "color", "$value": "{palette.cream}" },
      "surface":       { "$type": "color", "$value": "{palette.white}" },
      "surface-tint":  { "$type": "color", "$value": "{palette.mist}" },
      "surface-sand":  { "$type": "color", "$value": "{palette.sand}" },
      "surface-inverse":{ "$type": "color", "$value": "{palette.charcoal}" },
      "ink":           { "$type": "color", "$value": "{palette.charcoal}" },
      "ink-muted":     { "$type": "color", "$value": "{palette.charcoal-700}" },
      "ink-subtle":    { "$type": "color", "$value": "{palette.charcoal-500}" },
      "ink-inverse":   { "$type": "color", "$value": "{palette.cream}" },
      "brand":         { "$type": "color", "$value": "{palette.teal}" },
      "brand-hover":   { "$type": "color", "$value": "{palette.teal-light}" },
      "brand-soft":    { "$type": "color", "$value": "{palette.mist}" },
      "ink-on-brand":  { "$type": "color", "$value": "{palette.cream}" },
      "accent":        { "$type": "color", "$value": "{palette.terra}" },
      "accent-hover":  { "$type": "color", "$value": "{palette.terra-light}" },
      "border":        { "$type": "color", "$value": "{palette.border}" },
      "border-strong": { "$type": "color", "$value": "{palette.border-strong}" },
      "focus":         { "$type": "color", "$value": "{palette.teal}" },
      "footer-bg":     { "$type": "color", "$value": "{palette.charcoal}" },
      "footer-ink":    { "$type": "color", "$value": "{palette.cream}" },
      "footer-link":   { "$type": "color", "$value": "#9CC9C9" }
    },
    "dark": {
      "canvas":        { "$type": "color", "$value": "{palette.ink-900}" },
      "surface":       { "$type": "color", "$value": "{palette.ink-800}" },
      "surface-tint":  { "$type": "color", "$value": "{palette.ink-tint}" },
      "surface-sand":  { "$type": "color", "$value": "{palette.ink-700}" },
      "surface-inverse":{ "$type": "color", "$value": "{palette.paper-100}" },
      "ink":           { "$type": "color", "$value": "{palette.paper-100}" },
      "ink-muted":     { "$type": "color", "$value": "{palette.paper-300}" },
      "ink-subtle":    { "$type": "color", "$value": "{palette.paper-500}" },
      "ink-inverse":   { "$type": "color", "$value": "{palette.ink-900}" },
      "brand":         { "$type": "color", "$value": "{palette.teal-300}" },
      "brand-hover":   { "$type": "color", "$value": "{palette.teal-200}" },
      "brand-soft":    { "$type": "color", "$value": "{palette.ink-tint}" },
      "ink-on-brand":  { "$type": "color", "$value": "{palette.ink-900}" },
      "accent":        { "$type": "color", "$value": "{palette.terra-300}" },
      "accent-hover":  { "$type": "color", "$value": "{palette.terra-light}" },
      "border":        { "$type": "color", "$value": "{palette.ink-border}" },
      "border-strong": { "$type": "color", "$value": "#4A463F" },
      "focus":         { "$type": "color", "$value": "{palette.teal-200}" },
      "footer-bg":     { "$type": "color", "$value": "#131211" },
      "footer-ink":    { "$type": "color", "$value": "{palette.paper-100}" },
      "footer-link":   { "$type": "color", "$value": "#9CC9C9" }
    }
  },
  "font": {
    "family": {
      "heading": { "$type": "fontFamily", "$value": ["Merriweather", "Georgia", "serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "44px" },
      "h1":      { "$type": "dimension", "$value": "32px" },
      "h2":      { "$type": "dimension", "$value": "24px" },
      "h3":      { "$type": "dimension", "$value": "20px" },
      "body-lg": { "$type": "dimension", "$value": "18px" },
      "body":    { "$type": "dimension", "$value": "16px" },
      "small":   { "$type": "dimension", "$value": "14px" },
      "micro":   { "$type": "dimension", "$value": "12px" }
    },
    "lineHeight": {
      "tight":   { "$type": "number", "$value": 1.2 },
      "heading": { "$type": "number", "$value": 1.3 },
      "body":    { "$type": "number", "$value": 1.7 },
      "snug":    { "$type": "number", "$value": 1.5 }
    },
    "letterSpacing": {
      "display": { "$type": "dimension", "$value": "-0.01em" },
      "normal":  { "$type": "dimension", "$value": "0" },
      "eyebrow": { "$type": "dimension", "$value": "0.08em" }
    }
  },
  "type": {
    "display":  { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": "{font.weight.bold}", "fontSize": "{font.size.display}", "lineHeight": "{font.lineHeight.tight}", "letterSpacing": "{font.letterSpacing.display}" } },
    "h1":       { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": "{font.weight.bold}", "fontSize": "{font.size.h1}", "lineHeight": "{font.lineHeight.heading}" } },
    "h2":       { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": "{font.weight.bold}", "fontSize": "{font.size.h2}", "lineHeight": "{font.lineHeight.heading}" } },
    "h3":       { "$type": "typography", "$value": { "fontFamily": "{font.family.heading}", "fontWeight": "{font.weight.bold}", "fontSize": "{font.size.h3}", "lineHeight": "{font.lineHeight.heading}" } },
    "body-lg":  { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.body-lg}", "lineHeight": "{font.lineHeight.body}" } },
    "body":     { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.body}", "lineHeight": "{font.lineHeight.body}" } },
    "label":    { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.medium}", "fontSize": "{font.size.small}", "lineHeight": "{font.lineHeight.snug}" } },
    "eyebrow":  { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.semibold}", "fontSize": "{font.size.micro}", "lineHeight": "{font.lineHeight.snug}", "letterSpacing": "{font.letterSpacing.eyebrow}", "textCase": "uppercase" } },
    "micro":    { "$type": "typography", "$value": { "fontFamily": "{font.family.body}", "fontWeight": "{font.weight.regular}", "fontSize": "{font.size.micro}", "lineHeight": "{font.lineHeight.snug}" } }
  },
  "space": {
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "24px" },
    "6":  { "$type": "dimension", "$value": "32px" },
    "7":  { "$type": "dimension", "$value": "40px" },
    "8":  { "$type": "dimension", "$value": "56px" },
    "9":  { "$type": "dimension", "$value": "80px" },
    "10": { "$type": "dimension", "$value": "120px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "4px" },
    "md":   { "$type": "dimension", "$value": "6px" },
    "lg":   { "$type": "dimension", "$value": "8px" },
    "xl":   { "$type": "dimension", "$value": "12px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "control":  { "$type": "dimension", "$value": "2px" },
    "marker":   { "$type": "dimension", "$value": "4px" }
  },
  "layout": {
    "container":   { "$type": "dimension", "$value": "1120px" },
    "gutter":      { "$type": "dimension", "$value": "24px" },
    "nav-height":  { "$type": "dimension", "$value": "72px" },
    "measure":     { "$type": "dimension", "$value": "68ch" },
    "section-y":   { "$type": "dimension", "$value": "80px" },
    "section-y-sm":{ "$type": "dimension", "$value": "56px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": { "color": "rgba(45,45,45,0.06)", "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0" } },
    "md": { "$type": "shadow", "$value": { "color": "rgba(45,45,45,0.08)", "offsetX": "0", "offsetY": "2px", "blur": "8px", "spread": "0" } },
    "lg": { "$type": "shadow", "$value": { "color": "rgba(45,45,45,0.10)", "offsetX": "0", "offsetY": "8px", "blur": "24px", "spread": "0" } }
  },
  "motion": {
    "fast":   { "$type": "duration", "$value": "100ms" },
    "base":   { "$type": "duration", "$value": "200ms" },
    "slow":   { "$type": "duration", "$value": "320ms" },
    "easing": { "$type": "cubicBezier", "$value": [0.25, 0.1, 0.25, 1] }
  }
}
